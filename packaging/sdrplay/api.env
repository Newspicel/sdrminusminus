# The vendor SDK the SoapySDRPlay3 module is compiled against, and the module itself.
#
# The SDK is downloaded at build time and never redistributed: SDRplay's licence grants the right
# to display and perform the software in object form, not to copy it, so only the MIT-licensed
# module we compile from it reaches an artifact. Downloading accepts that licence — see
# docs/src/hardware.md.
#
# The download endpoints serve whatever version is current, so the file name and digest below are
# the version pin. A release that fails on a digest mismatch is SDRplay having published a new
# API: check the new version against the module's requirements, then re-pin all three lines.

API_VERSION="3.15"

MODULE_TAG="soapy-sdrplay3-0.5.2"
MODULE_COMMIT="8ef31b232a904ac3061edaa70d96f0155c0bba45"

LINUX_URL="https://sdrplay.com/download/hardware-api-linux/?wpdmdl=1906"
LINUX_FILE="SDRplay_RSP_API-Linux-3.15.2.run"
LINUX_SHA256="3a97ca764263bbe76fb0f2220e6408942357e8864c19e1408a6d6987af382fe3"

MACOS_URL="https://sdrplay.com/download/hardware-api-macos/?wpdmdl=1907"
MACOS_FILE="SDRplayAPI-macos-installer-universal-3.15.1.pkg"
MACOS_SHA256="5d148ceda1fae775d2d2df5b3fcf46dee27b6222e2535c4c063c2f2ea2f7acc3"

WINDOWS_URL="https://sdrplay.com/download/hardware-api-windows/?wpdmdl=1905"
WINDOWS_FILE="SDRplay_RSP_API-Windows-3.15.exe"
WINDOWS_SHA256="8ad5c36f1ca26cf7a61010c3f3c80dae69d4468ef5e59f7a0d42fb135a1c7326"
