{
  "name": "sdrmm-site",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.8.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro sync && tsgo --noEmit && astro build",
    "preview": "wrangler dev",
    "test": "vitest run",
    "format": "biome check --write .",
    "typecheck": "astro sync && tsgo --noEmit && wrangler types worker/worker-configuration.d.ts && tsgo --noEmit -p worker"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "^7.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxc-transform-react": "^0.152.0",
    "tailwindcss": "4.3.3",
    "vitest": "5.0.2",
    "wrangler": "4.144.0"
  }
}
