---
import { CONTACT_PATH, type ContactOutcome, FIELDS, LIMITS } from "../contact";
import Page from "../layouts/Page.astro";
import { euros, PLANS } from "../plans";

const mail = "hi@jhaag.me";
const team = PLANS.find((plan) => plan.perSeat);

const offers = [
  {
    title: "Commercial license",
    text: "Ship SDR-- in a closed product or service, on terms other than the AGPL.",
  },
  {
    title: "Custom work",
    text: "A decoder, a protocol or a node you need, built and tested.",
  },
  {
    title: "Radio makers",
    text: "Get your hardware supported, tested and listed.",
  },
  {
    title: "Deployments",
    text: "Receivers at remote sites, set up and kept running.",
  },
];

const outcomes: { id: ContactOutcome; text: string }[] = [
  { id: "sent", text: "Sent. We'll get back to you soon." },
  { id: "invalid", text: "Check your name, email and message." },
  { id: "busy", text: "Too many messages. Try again in a minute." },
  { id: "failed", text: "Could not send. Mail us instead:" },
];
---

<Page
  title="SDR-- for business"
  description="Commercial licenses, custom decoders, radio support and deployments for SDR--."
  summary="Commercial licenses, custom work and support for SDR--."
>
  <div class="wrap business">
    <div class="pitch">
      <h1>SDR-- for business</h1>
      <p class="lede">Building a product, a monitoring station or a radio? Tell us what you need.</p>
      <ul class="offers">
        {
          offers.map((offer) => (
            <li>
              <h2>{offer.title}</h2>
              <p>{offer.text}</p>
            </li>
          ))
        }
        {
          team && (
            <li>
              <h2>Remote access for a team</h2>
              <p>
                app.sdrmm.com for everyone at {euros(team.monthly)} per seat a month, from {team.minSeats} seats.
                <a href="/remote#pricing">Pricing</a>
              </p>
            </li>
          )
        }
      </ul>
      <p class="else">Something else? Rough ideas welcome.</p>
    </div>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Get in touch</h2>
      <p class="who">Your message goes to Julian Haag, who builds SDR--.</p>
      <form method="post" action={CONTACT_PATH}>
        <label>
          <span>Name</span>
          <input name={FIELDS.name} autocomplete="name" maxlength={LIMITS.name} required />
        </label>
        <label>
          <span>Email</span>
          <input
            type="email"
            name={FIELDS.email}
            autocomplete="email"
            maxlength={LIMITS.email}
            required
          />
        </label>
        <label class="wide">
          <span>Message</span>
          <textarea name={FIELDS.message} rows="7" maxlength={LIMITS.message} required></textarea>
        </label>
        <label class="trap" aria-hidden="true">
          <span>Website</span>
          <input name={FIELDS.trap} tabindex="-1" autocomplete="off" />
        </label>
        <div class="send wide">
          <button class="btn primary" type="submit">Send</button>
          <a href="/privacy">Privacy</a>
        </div>
        <div class="outcomes wide" role="status" aria-live="polite">
          {
            outcomes.map((outcome) => (
              <p id={outcome.id} class="outcome" data-outcome={outcome.id} hidden>
                {outcome.text}
                {outcome.id === "failed" && <a href={`mailto:${mail}`}>{mail}</a>}
              </p>
            ))
          }
        </div>
      </form>
    </section>
  </div>
</Page>

<script>
  import { type ContactOutcome, isOutcome } from "../contact";

  async function submit(form: HTMLFormElement): Promise<ContactOutcome> {
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { accept: "application/json" },
      });
      const body: unknown = await response.json();
      const outcome = typeof body === "object" && body !== null && "outcome" in body ? body.outcome : null;
      return isOutcome(outcome) ? outcome : "failed";
    } catch {
      return "failed";
    }
  }

  function show(form: HTMLFormElement, outcome: ContactOutcome | null) {
    form.dataset.submitted = "";
    for (const element of form.querySelectorAll<HTMLElement>(".outcome")) {
      element.hidden = element.dataset.outcome !== outcome;
    }
  }

  const form = document.querySelector<HTMLFormElement>("#contact form");
  const button = form?.querySelector("button");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (button) {
      button.disabled = true;
    }
    show(form, null);
    const outcome = await submit(form);
    show(form, outcome);
    if (outcome === "sent") {
      form.reset();
    }
    if (button) {
      button.disabled = false;
    }
  });
</script>

<style>
  .business {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(40px, 7vw, 96px);
    align-items: start;
    padding-block: clamp(56px, 9vw, 112px);
  }
  h1 {
    font-size: clamp(2.4rem, 5.6vw, 4.2rem);
  }
  .lede {
    margin-bottom: 48px;
  }

  .offers {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .offers li {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: 6px 32px;
    align-items: baseline;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
  }
  .offers h2 {
    margin: 0;
    font: 600 1.1rem/1.4 var(--sans);
    letter-spacing: -0.01em;
  }
  .offers p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 15px;
  }
  .else {
    margin: 22px 0 0;
    color: var(--ink-faint);
    font-size: 15px;
  }

  .contact {
    position: sticky;
    top: 84px;
    padding: 28px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--panel);
    box-shadow: var(--shadow-face);
  }
  .contact h2 {
    margin-bottom: 6px;
    font-size: 1.6rem;
  }
  .who {
    margin: 0 0 24px;
    color: var(--ink-faint);
    font-size: 14px;
  }
  form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
  }
  .wide {
    grid-column: 1 / -1;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  label span {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-dim);
  }
  input,
  textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--well);
    color: var(--ink);
    font: inherit;
    font-size: 16px;
  }
  textarea {
    resize: vertical;
    min-height: 140px;
  }
  input:hover,
  textarea:hover {
    border-color: var(--line-strong);
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: transparent;
  }
  .trap {
    position: absolute;
    left: -9999px;
  }
  .send {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .send button {
    cursor: pointer;
  }
  .send button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .send a {
    font-size: 14px;
    color: var(--ink-faint);
  }
  .outcome {
    margin: 0;
    color: var(--ink-dim);
  }
  form:not([data-submitted]) .outcome:target {
    display: block;
  }
  .outcome[data-outcome="sent"] {
    color: var(--audio);
  }
  .outcome[data-outcome="failed"],
  .outcome[data-outcome="invalid"],
  .outcome[data-outcome="busy"] {
    color: var(--events);
  }
  .outcome a {
    margin-left: 6px;
  }

  @media (max-width: 900px) {
    .business {
      grid-template-columns: minmax(0, 1fr);
    }
    .contact {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .offers li {
      grid-template-columns: minmax(0, 1fr);
    }
    .contact {
      padding: 22px 18px;
    }
  }
</style>
