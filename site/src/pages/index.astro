---
import Patch from "../components/Patch.astro";
import { DEFAULT_SCENE, demoUrl, SCENES } from "../demo/scenes";
import Page from "../layouts/Page.astro";

const outputs = [
  {
    port: "audio",
    name: "Audio",
    title: "Voice and music",
    modes: [
      "AM",
      "NFM",
      "SSB",
      "CW",
      "FM stereo",
      "RDS",
      "DMR",
      "FreeDV",
      "D-STAR",
      "Fusion",
      "NXDN",
      "P25",
      "dPMR",
      "M17",
    ],
  },
  {
    port: "events",
    name: "Events",
    title: "Messages and positions",
    modes: [
      "ADS-B",
      "ACARS",
      "VDL2",
      "HFDL",
      "AIS",
      "NAVTEX",
      "DSC",
      "POCSAG",
      "FLEX",
      "ERMES",
      "FT8",
      "FT4",
      "WSPR",
      "APRS",
      "RTTY",
      "PSK",
      "ISM sensors",
      "Time signals",
    ],
  },
  {
    port: "video",
    name: "Video",
    title: "Pictures",
    modes: ["SSTV", "ATV", "DVB-S", "DVB-S2"],
  },
  {
    port: "iq",
    name: "IQ",
    title: "Samples to keep",
    modes: ["Record", "Replay", "SigMF", "Network IQ", "rtl_tcp"],
  },
];

const tools = [
  {
    title: "See the band",
    text: "Spectrum, waterfall, constellation and map, with decoded messages beside them.",
  },
  {
    title: "Find the signal",
    text: "Scanning, signal identification, satellites, direction finding and passive radar.",
  },
  {
    title: "Drive it from elsewhere",
    text: "REST, WebSocket, MCP and event forwarding to your own tools.",
  },
];
---

<Page
  title="SDR-- · patch a radio together"
  description="A software-defined radio application for listening, decoding and recording. Connect a receiver, a channel and a display, on your desk or on a server at the antenna."
  summary="A software-defined radio application for listening, decoding and recording."
>
  <div class="wrap hero">
    <h1>Patch a radio together</h1>
    <div class="pitch">
      <p class="lede">Wire a receiver to a channel, the channel to a speaker, a map or a recorder.
        On your desk, or on a server at the antenna.</p>
      <div class="actions">
        <a class="btn primary" href="/download.html">Download</a>
        <a class="btn ghost" href="/getting-started/first-receiver.html">First receiver guide</a>
      </div>
      <p class="platforms">macOS, Windows, Linux. Free and open source.</p>
    </div>
    <Patch />
  </div>

  <div class="demo" id="demo">
    <div class="wrap">
      <div class="scenes">
        <div role="tablist" aria-label="Demo session">
          {
            SCENES.map((scene) => (
              <button
                type="button"
                role="tab"
                data-scene={scene.id}
                aria-selected={scene.id === DEFAULT_SCENE ? "true" : "false"}
              >
                {scene.label}
              </button>
            ))
          }
        </div>
        <a class="full" href={demoUrl(DEFAULT_SCENE)}>Full screen</a>
      </div>
      <div class="window">
        <iframe src={demoUrl(DEFAULT_SCENE)} title="SDR-- replaying a recorded session" loading="lazy"></iframe>
        <img
          class="still"
          src="/screens/patch.png"
          alt="A patch with a signal generator feeding a scope and three channels, wired to a speaker, a recorder and a network IQ export."
          width="2160"
          height="1350"
        />
      </div>
      <p class="caption">The real app, replaying a recorded session. Drag, zoom, press Play on a speaker.</p>
    </div>
  </div>

  <section class="wrap">
    <h2>Choose what the signal becomes</h2>
    <p class="section-lede">A channel turns IQ into something you can use. Its output is what sets it apart.</p>

    <div class="outputs">
      {
        outputs.map((output) => (
          <div class={`output ${output.port}`}>
            <p class="port"><span class="dot" />{output.name}</p>
            <h3>{output.title}</h3>
            <ul class="modes">
              {output.modes.map((mode) => <li>{mode}</li>)}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="tools">
      {
        tools.map((tool) => (
          <div>
            <h3>{tool.title}</h3>
            <p>{tool.text}</p>
          </div>
        ))
      }
    </div>

    <p class="note">Modes range from tested on air to experimental. The
      <a href="/user-guide/decoders.html#catalog">decoder catalog</a> says which.</p>
  </section>

  <section class="wrap">
    <h2>Install it</h2>
    <p class="section-lede">The app runs its own server. Or run the server alone by the antenna and
      open it from any browser.</p>

    <div class="install">
      <div class="lane">
        <h3>Desktop app</h3>
        <p><code>.dmg</code> for macOS, <code>.msi</code> or <code>.exe</code> for Windows,
          <code>.deb</code> or <code>.AppImage</code> for Linux.</p>
        <p class="foot"><a class="btn primary" href="/download.html">Pick your file</a></p>
      </div>

      <div class="lane">
        <h3>Homebrew</h3>
        <pre>brew tap newspicel/tap
brew install --cask sdrminusminus

<span class="p">or the server</span>
brew install sdrmm
brew services start sdrmm</pre>
        <p class="foot"><a href="/getting-started/install.html">All methods, including Nix</a></p>
      </div>

      <div class="lane">
        <h3>Container</h3>
        <pre>git clone https://github.com/Newspicel/sdrminusminus.git
cd sdrminusminus
docker compose up -d</pre>
        <p class="foot"><a href="/server/deployment.html">Setup, auth and HTTPS</a></p>
      </div>
    </div>

    <p class="note">Then open <code>localhost:8080</code> and pick your radio on a Device node. The
      server has no auth by default: set <a href="/server/configuration.html">a token and HTTPS</a>
      before exposing it.</p>
  </section>

  <section class="wrap closing">
    <h2>Still being built</h2>
    <p class="section-lede">The docs say plainly what works on air and what is experimental. Bug
      reports and decoder recordings are welcome.</p>
    <div class="actions">
      <a class="btn ghost" href="https://github.com/Newspicel/sdrminusminus">Source on GitHub</a>
      <a class="btn ghost" href="/development/architecture.html">Architecture</a>
    </div>
  </section>
</Page>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    grid-template-areas: "title title" "pitch patch";
    align-items: center;
    column-gap: clamp(32px, 5vw, 72px);
    padding-top: clamp(40px, 7vw, 80px);
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .hero h1 { grid-area: title; max-width: none; }
  .pitch { grid-area: pitch; }
  .hero :global(.patch) { grid-area: patch; margin-top: clamp(-150px, -9vw, -60px); }
  .platforms { margin: 18px 0 0; font-size: 14px; color: var(--ink-faint); }

  .demo {
    border-block: 1px solid var(--line);
    background-color: var(--well);
    background-image: radial-gradient(circle, var(--line) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: 12px 12px;
    padding-block: clamp(24px, 4vw, 48px);
  }

  .scenes {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 12px;
  }
  .scenes [role="tablist"] { display: flex; flex-wrap: wrap; }
  .scenes button {
    height: 34px;
    padding-inline: 14px;
    border: 1px solid transparent;
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
    background: none;
    color: var(--ink-faint);
    font: 12.5px var(--mono);
    cursor: pointer;
  }
  .scenes button:hover { color: var(--ink); }
  .scenes button[aria-selected="true"] {
    color: var(--ink);
    background: var(--panel-2);
    border-color: var(--line-strong);
    box-shadow: inset 0 2px 0 var(--accent);
  }
  .scenes .full { margin-bottom: 8px; font: 12.5px var(--mono); color: var(--ink-dim); }
  .scenes .full:hover { color: var(--accent); }

  .window {
    border: 1px solid var(--line-strong);
    border-radius: 0 4px 4px 4px;
    overflow: hidden;
    background: var(--bg);
    aspect-ratio: 16 / 10;
    max-height: 82vh;
    width: 100%;
    box-shadow: 0 30px 80px -30px black;
  }
  .window iframe { display: block; width: 100%; height: 100%; border: 0; }
  .window .still { display: none; width: 100%; height: auto; }
  .caption { margin: 14px 0 0; font-size: 14px; color: var(--ink-faint); }

  .outputs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .output {
    background: var(--bg);
    padding: 26px 28px 30px;
    box-shadow: inset 0 2px 0 var(--port);
  }
  .output .port {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 6px;
    font: 12px var(--mono);
    color: var(--port);
  }
  .output .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--port);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--port) 22%, transparent);
  }
  .output h3 { margin: 0 0 16px; font-size: 1.2rem; font-weight: 600; }
  .modes { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  .modes li {
    font: 12.5px/1 var(--mono);
    padding: 6px 8px;
    border-radius: 3px;
    color: var(--ink-dim);
    background: color-mix(in oklab, var(--port) 9%, var(--panel));
    border: 1px solid color-mix(in oklab, var(--port) 22%, var(--line));
  }
  .output.audio { --port: var(--audio); }
  .output.events { --port: var(--events); }
  .output.video { --port: var(--video); }
  .output.iq { --port: var(--iq); }

  .tools {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 28px 40px;
  }
  .tools h3 { margin: 0 0 6px; font-size: 1rem; font-weight: 600; }
  .tools p { margin: 0; color: var(--ink-dim); font-size: 15px; }

  .closing { border-top: 1px solid var(--line); }

  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); grid-template-areas: "title" "pitch" "patch"; row-gap: 40px; }
    .hero :global(.patch) { margin-top: 0; }
    .scenes { display: none; }
    .window { aspect-ratio: auto; max-height: none; border-radius: 4px; }
    .window iframe { display: none; }
    .window .still { display: block; }
  }

  @media (max-width: 720px) {
    .outputs { grid-template-columns: minmax(0, 1fr); }
    .output { padding: 22px 18px 24px; }
  }
</style>

<script>
  import { demoUrl } from "../demo/scenes";

  const frame = document.querySelector<HTMLIFrameElement>(".window iframe");
  const full = document.querySelector<HTMLAnchorElement>(".scenes .full");
  const tabs = document.querySelectorAll<HTMLButtonElement>(".scenes [data-scene]");

  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      const url = demoUrl(tab.dataset.scene ?? "");
      for (const other of tabs) {
        other.setAttribute("aria-selected", String(other === tab));
      }
      if (frame !== null) {
        frame.src = url;
      }
      if (full !== null) {
        full.href = url;
      }
    });
  }
</script>
