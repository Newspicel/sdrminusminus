---
import Page from "../layouts/Page.astro";
---

<Page
  title="Download SDR--"
  description="Installers for macOS, Windows and Linux, portable servers for a machine by the antenna, and the package managers that carry SDR--."
  summary="Pick the file for the computer you will run the radio on."
  current="download"
>
<div class="wrap top">
  <h1>Download SDR--</h1>
  <p class="lede">Take the app for the computer your radio plugs into, or the server for a machine
    by the antenna.</p>

  <div class="pick">
    <p class="who" id="pick-who">Latest release</p>
    <a class="btn primary" id="pick-btn" href="https://github.com/Newspicel/sdrminusminus/releases/latest">Download SDR--</a>
    <p class="file" id="pick-file">Desktop app for macOS, Windows and Linux.</p>
    <p class="hint" id="pick-hint" hidden></p>
    <p class="alts" id="pick-alts"><a href="#files">Every file in the release</a><a href="#choose">Not sure which you want?</a></p>
  </div>
</div>

<section class="wrap" id="choose">
  <h2>App or server</h2>
  <p class="section-lede">It depends on where the radio sits.</p>

  <div class="install">
    <div class="lane">
      <h3>Desktop app</h3>
      <p>The radio plugs into this computer. Installs like any app, nothing else to set up. Take
        this one if unsure.</p>
      <p class="foot"><a href="#files">macOS, Windows and Linux installers</a></p>
    </div>

    <div class="lane">
      <h3>Portable server</h3>
      <p>The radio is elsewhere: a Pi in the loft, a box by the antenna. Start <code>sdrmm</code>
        and open port 8080 from any browser.</p>
      <p class="foot"><a href="/server/deployment.html">Run it as a service</a></p>
    </div>
  </div>

  <p class="note">The server listens on every interface without authentication by default. Set
    <a href="/server/configuration.html">a token and HTTPS</a> before it faces a network you do
    not trust.</p>
</section>

<section class="wrap" id="files">
  <h2>Every file</h2>
  <p class="stamp" id="stamp">Latest stable release · <a href="https://github.com/Newspicel/sdrminusminus/releases/latest">release notes</a></p>

  <div class="files">
    <div class="group">
      <h3><span class="os">macOS</span>Apple silicon and Intel</h3>
      <ul>
        <li><a class="row" data-file="_aarch64.dmg" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Desktop app <em>Apple silicon</em></span>
          <span class="size"></span>
          <span class="name">SDR--_&lt;version&gt;_aarch64.dmg</span>
        </a></li>
        <li><a class="row" data-file="_x64.dmg" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Desktop app <em>Intel</em></span>
          <span class="size"></span>
          <span class="name">SDR--_&lt;version&gt;_x64.dmg</span>
        </a></li>
        <li><a class="row" data-file="-aarch64-apple-darwin.tar.gz" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Server <em>Apple silicon</em></span>
          <span class="size"></span>
          <span class="name">sdrmm-&lt;version&gt;-aarch64-apple-darwin.tar.gz</span>
        </a></li>
        <li><a class="row" data-file="-x86_64-apple-darwin.tar.gz" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Server <em>Intel</em></span>
          <span class="size"></span>
          <span class="name">sdrmm-&lt;version&gt;-x86_64-apple-darwin.tar.gz</span>
        </a></li>
      </ul>
    </div>

    <div class="group">
      <h3><span class="os">Windows</span>x86-64 and ARM64</h3>
      <ul>
        <li><a class="row" data-file="_x64-setup.exe" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Desktop app <em>installer</em></span>
          <span class="size"></span>
          <span class="name">SDR--_&lt;version&gt;_x64-setup.exe</span>
        </a></li>
        <li><a class="row" data-file="_x64_en-US.msi" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Desktop app <em>MSI package</em></span>
          <span class="size"></span>
          <span class="name">SDR--_&lt;version&gt;_x64_en-US.msi</span>
        </a></li>
        <li><a class="row" data-file="_arm64-setup.exe" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Desktop app <em>installer, ARM64</em></span>
          <span class="size"></span>
          <span class="name">SDR--_&lt;version&gt;_arm64-setup.exe</span>
        </a></li>
        <li><a class="row" data-file="-x86_64-pc-windows-msvc.zip" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Server <em>zip archive, x86-64</em></span>
          <span class="size"></span>
          <span class="name">sdrmm-&lt;version&gt;-x86_64-pc-windows-msvc.zip</span>
        </a></li>
        <li><a class="row" data-file="-aarch64-pc-windows-msvc.zip" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Server <em>zip archive, ARM64</em></span>
          <span class="size"></span>
          <span class="name">sdrmm-&lt;version&gt;-aarch64-pc-windows-msvc.zip</span>
        </a></li>
      </ul>
    </div>

    <div class="group">
      <h3><span class="os">Linux</span>x86-64 and ARM64</h3>
      <ul>
        <li><a class="row" data-file="_amd64.AppImage" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Desktop app <em>AppImage, any distribution</em></span>
          <span class="size"></span>
          <span class="name">SDR--_&lt;version&gt;_amd64.AppImage</span>
        </a></li>
        <li><a class="row" data-file="_amd64.deb" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Desktop app <em>Debian and Ubuntu</em></span>
          <span class="size"></span>
          <span class="name">SDR--_&lt;version&gt;_amd64.deb</span>
        </a></li>
        <li><a class="row" data-file="_aarch64.AppImage" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Desktop app <em>AppImage, ARM64</em></span>
          <span class="size"></span>
          <span class="name">SDR--_&lt;version&gt;_aarch64.AppImage</span>
        </a></li>
        <li><a class="row" data-file="_arm64.deb" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Desktop app <em>Debian and Ubuntu, ARM64</em></span>
          <span class="size"></span>
          <span class="name">SDR--_&lt;version&gt;_arm64.deb</span>
        </a></li>
        <li><a class="row" data-file="-x86_64-unknown-linux-gnu.tar.gz" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Server <em>x86-64</em></span>
          <span class="size"></span>
          <span class="name">sdrmm-&lt;version&gt;-x86_64-unknown-linux-gnu.tar.gz</span>
        </a></li>
        <li><a class="row" data-file="-aarch64-unknown-linux-gnu.tar.gz" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Server <em>ARM64, Raspberry Pi</em></span>
          <span class="size"></span>
          <span class="name">sdrmm-&lt;version&gt;-aarch64-unknown-linux-gnu.tar.gz</span>
        </a></li>
      </ul>
    </div>

    <div class="group">
      <h3><span class="os">Source</span>Build it yourself</h3>
      <ul>
        <li><a class="row" data-file="-src.tar.gz" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Source tarball <em>vendored, builds offline</em></span>
          <span class="size"></span>
          <span class="name">sdrmm-&lt;version&gt;-src.tar.gz</span>
        </a></li>
        <li><a class="row" data-file="SHA256SUMS" href="https://github.com/Newspicel/sdrminusminus/releases/latest">
          <span class="what">Checksums <em>verify what you downloaded</em></span>
          <span class="size"></span>
          <span class="name">SHA256SUMS</span>
        </a></li>
      </ul>
    </div>
  </div>

  <p class="note">There is no ARM Linux desktop bundle yet: on a Pi, run the server and open it in
    a browser. The rolling
    <a href="https://github.com/Newspicel/sdrminusminus/releases/tag/nightly">nightly</a> follows
    <code>main</code> and can change saved-data formats without migrating them. Use a stable
    release unless you are testing one.</p>
</section>

<section class="wrap">
  <h2>Or install it with a package manager</h2>
  <p class="section-lede">Same releases, updated with the rest of your system.</p>

  <div class="install">
    <div class="lane">
      <h3>Homebrew</h3>
      <p>The cask installs the app; the formula installs the headless server.</p>
      <div class="shell"><pre>brew tap newspicel/tap
brew install --cask sdrminusminus

<span class="p">or, for a server</span>
brew install sdrmm
brew services start sdrmm</pre></div>
    </div>

    <div class="lane">
      <h3>Nix</h3>
      <p>Flake package for x86-64 and ARM64 Linux, with SoapySDR modules selectable.</p>
      <div class="shell"><pre>nix profile install \
  github:Newspicel/sdrminusminus
sdrmm-desktop</pre></div>
      <p class="foot"><a href="/getting-started/install.html#nix">NixOS module options</a></p>
    </div>

    <div class="lane">
      <h3>Container</h3>
      <p>Persists its database and recordings in a volume. Pass through the USB group that owns
        your radio.</p>
      <div class="shell"><pre>git clone https://github.com/Newspicel/sdrminusminus.git
cd sdrminusminus
docker compose up -d</pre></div>
      <p class="foot"><a href="/server/deployment.html">Container setup, auth and HTTPS</a></p>
    </div>
  </div>
</section>

<section class="wrap">
  <h2>Once it has downloaded</h2>

  <ol class="steps">
    <li>
      <div>
        <h3>Install it</h3>
        <p>macOS: open the disk image and drag SDR-- to Applications. Windows: run the installer.
          It is not code-signed yet, so SmartScreen asks first; choose <b>More info</b>, then
          <b>Run anyway</b>. Linux: <code>chmod +x</code> the AppImage, or
          <code>sudo apt install ./SDR--*.deb</code>. Servers: unpack the archive and run
          <code>./sdrmm</code>.</p>
      </div>
    </li>
    <li>
      <div>
        <h3>Open it</h3>
        <p>The app opens its own window. The server prints its address. Reach it at
          <code>http://localhost:8080</code>, or <code>http://&lt;machine&gt;:8080</code> from
          another computer on the network.</p>
      </div>
    </li>
    <li>
      <div>
        <h3>Patch a receiver</h3>
        <p>Drop a <b>Device</b> node, select your radio, wire its IQ output into a channel and the
          channel into a speaker. If the radio is not listed, use <b>Check hardware</b> on the node
          or run <code>sdrmm --doctor</code>.</p>
      </div>
    </li>
  </ol>

  <p class="note">Next: <a href="/getting-started/first-receiver.html">your first receiver</a>,
    the <a href="/hardware.html">hardware guide</a> for what each radio needs, or
    <a href="/troubleshooting.html">troubleshooting</a> when something stays silent.</p>

  <div class="actions next">
    <a class="btn ghost" href="/getting-started/install.html">All install methods</a>
    <a class="btn ghost" href="/development/building.html">Build from source</a>
  </div>
</section>
</Page>

<style is:global>
.top {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-top: clamp(56px, 9vw, 112px);
  padding-bottom: clamp(24px, 4vw, 40px);
}
.top .lede { margin-inline: auto; }

.pick {
  width: 100%;
  max-width: 560px;
  margin-top: 8px;
  padding: 32px 28px 26px;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-lg);
  background:
    radial-gradient(100% 80% at 50% 0%, color-mix(in oklab, var(--accent) 12%, transparent), transparent 70%),
    var(--panel);
  box-shadow: var(--glow);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
}
.pick .who { margin: 0; font-size: 14px; color: var(--ink-dim); }
.pick .btn.primary { font-size: 16px; padding: 14px 28px; }
.pick .file { margin: 0; font-family: var(--mono); font-size: 12.5px; color: var(--ink-faint); overflow-wrap: anywhere; }
.pick .hint { margin: 0; font-size: 14px; color: var(--ink-dim); max-width: 44ch; }
.pick .alts {
  margin: 6px 0 0;
  padding-top: 16px;
  border-top: 1px solid var(--line);
  align-self: stretch;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 4px 20px;
  font-size: 14px;
}
.pick .alts a { color: var(--ink-dim); text-decoration: none; }
.pick .alts a:hover { color: var(--ink); }

.stamp { margin: 0 0 28px; font-size: 14px; color: var(--ink-faint); }

.files {
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: color-mix(in oklab, var(--panel) 55%, var(--bg));
  overflow: hidden;
}
.group {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  gap: 10px 40px;
  padding: 24px 28px;
}
.group + .group { border-top: 1px solid var(--line); }
.group h3 { margin: 0; color: var(--ink-faint); font-weight: 400; font-size: 14px; }
.group h3 .os {
  display: block;
  margin-bottom: 2px;
  font-family: var(--display);
  font-stretch: 80%;
  font-size: 1.35rem;
  letter-spacing: -0.02em;
  color: var(--ink);
}
.group ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }

.row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 2px 16px;
  align-items: baseline;
  padding: 10px 14px;
  border: 1px solid transparent;
  border-radius: var(--radius);
  text-decoration: none;
  color: var(--ink);
  transition: background-color 0.15s, border-color 0.15s;
}
.row:hover { background: var(--panel-2); border-color: var(--line-strong); }
.row .what { font-size: 15px; font-weight: 500; }
.row .what em { font-style: normal; font-weight: 400; color: var(--ink-faint); }
.row .size { font-family: var(--mono); font-size: 12px; color: var(--ink-faint); text-align: right; white-space: nowrap; }
.row .name { grid-column: 1 / -1; font-family: var(--mono); font-size: 12px; color: var(--ink-faint); overflow-wrap: anywhere; }

.steps {
  margin: 0;
  padding: 0;
  list-style: none;
  counter-reset: step;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
}
.steps li {
  counter-increment: step;
  padding: 24px;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: linear-gradient(180deg, var(--panel), color-mix(in oklab, var(--panel) 40%, var(--bg)));
}
.steps li::before {
  content: counter(step);
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  margin-bottom: 16px;
  border-radius: 50%;
  background: var(--ink);
  color: var(--bg);
  font: 600 14px var(--display);
}
.steps h3 { margin: 0 0 6px; font-size: 1.08rem; font-weight: 600; }
.steps p { margin: 0; color: var(--ink-dim); font-size: 15px; }
.steps code { font-family: var(--mono); font-size: 0.88em; color: var(--ink); }

.next { margin-top: 28px; }

@media (max-width: 720px) {
  .group { grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 20px 14px; }
  .group h3 { padding-inline: 14px; }
}
</style>

<script is:inline>
const RELEASE = "https://api.github.com/repos/Newspicel/sdrminusminus/releases/latest";

const PICKS = {
  "mac-arm": { who: "macOS · Apple silicon", file: "_aarch64.dmg", label: "Download for macOS", alts: ["mac-intel"] },
  "mac-intel": { who: "macOS · Intel", file: "_x64.dmg", label: "Download for macOS", alts: ["mac-arm"] },
  windows: { who: "Windows · 64-bit", file: "_x64-setup.exe", label: "Download for Windows", alts: ["windows-msi"] },
  "windows-msi": { who: "Windows · MSI package", file: "_x64_en-US.msi", label: "Download for Windows", alts: ["windows"] },
  "windows-arm": { who: "Windows on ARM", file: "_arm64-setup.exe", label: "Download for Windows", alts: [] },
  linux: { who: "Linux · x86-64", file: "_amd64.AppImage", label: "Download for Linux", alts: ["linux-deb"] },
  "linux-deb": { who: "Linux · Debian and Ubuntu", file: "_amd64.deb", label: "Download for Linux", alts: ["linux"] },
  "linux-arm": { who: "Linux · ARM64", file: "_aarch64.AppImage", label: "Download for Linux", alts: ["linux-arm-deb", "linux-arm-server"] },
  "linux-arm-deb": { who: "Linux · Debian and Ubuntu, ARM64", file: "_arm64.deb", label: "Download for Linux", alts: ["linux-arm"] },
  "linux-arm-server": {
    who: "Linux · ARM64",
    file: "-aarch64-unknown-linux-gnu.tar.gz",
    label: "Download the server",
    hint: "Run this on the Pi and open port 8080 from any browser on the network.",
    alts: ["linux-arm"],
  },
};

const ALT_LABELS = {
  "mac-arm": "Apple silicon Mac instead",
  "mac-intel": "Intel Mac instead",
  windows: "Plain installer instead",
  "windows-msi": "MSI package instead",
  linux: "AppImage instead",
  "linux-deb": "Debian package instead",
  "linux-arm": "AppImage instead",
  "linux-arm-deb": "Debian package instead",
  "linux-arm-server": "Headless server instead",
};

const el = (id) => document.getElementById(id);
const filesize = (bytes) =>
  bytes >= 1048576 ? Math.round(bytes / 1048576) + " MB" : Math.max(1, Math.round(bytes / 1024)) + " KB";

async function architecture() {
  const data = navigator.userAgentData;
  if (!data || !data.getHighEntropyValues) return "";
  try {
    const values = await data.getHighEntropyValues(["architecture"]);
    return values.architecture || "";
  } catch {
    return "";
  }
}

function handheld() {
  const agent = navigator.userAgent;
  if (navigator.userAgentData && navigator.userAgentData.mobile) return true;
  if (/Android|iPhone|iPod/.test(agent)) return true;
  return /iPad/.test(agent) || (/Mac/.test(agent) && navigator.maxTouchPoints > 2);
}

async function detect() {
  if (handheld()) return "";
  const agent = navigator.userAgent;
  const family = (navigator.userAgentData && navigator.userAgentData.platform) || agent;
  const chip = await architecture();
  const arm = chip.startsWith("arm");
  if (/Mac/i.test(family)) return chip.startsWith("x86") ? "mac-intel" : "mac-arm";
  if (/Win/i.test(family)) return arm ? "windows-arm" : "windows";
  if (/Linux|X11|CrOS/i.test(family)) return arm || /aarch64|arm64/i.test(agent) ? "linux-arm" : "linux";
  return "";
}

function handheldCard() {
  el("pick-who").textContent = "Phone or tablet";
  el("pick-btn").textContent = "See every file";
  el("pick-btn").href = "#files";
  el("pick-file").textContent = "SDR-- runs on a desktop or a server.";
  el("pick-hint").textContent =
    "Install it on a computer, then open that machine's address in this browser to operate the receiver from here.";
  el("pick-hint").hidden = false;
  el("pick-alts").replaceChildren(link("#choose", "App or server?"));
}

function link(href, text, onClick) {
  const anchor = document.createElement("a");
  anchor.href = href;
  anchor.textContent = text;
  if (onClick) {
    anchor.addEventListener("click", (event) => {
      event.preventDefault();
      onClick();
    });
  }
  return anchor;
}

function show(key, assets) {
  const pick = PICKS[key];
  const asset = assets.find((candidate) => candidate.name.endsWith(pick.file));

  el("pick-who").textContent = pick.who;
  el("pick-btn").textContent = pick.label;
  el("pick-file").textContent = asset ? asset.name + " · " + filesize(asset.size) : "";
  el("pick-file").hidden = !asset;
  if (asset) el("pick-btn").href = asset.browser_download_url;
  el("pick-hint").textContent = pick.hint || "";
  el("pick-hint").hidden = !pick.hint;

  const alts = pick.alts.map((other) => link("#files", ALT_LABELS[other], () => show(other, assets)));
  alts.push(link("#files", "Every file in the release"), link("#choose", "App or server?"));
  el("pick-alts").replaceChildren(...alts);
}

async function release() {
  try {
    const answer = await fetch(RELEASE, { headers: { accept: "application/vnd.github+json" } });
    if (!answer.ok) return null;
    return await answer.json();
  } catch {
    return null;
  }
}

async function start() {
  const [key, latest] = await Promise.all([detect(), release()]);
  const assets = (latest && latest.assets) || [];

  if (latest) {
    el("stamp").replaceChildren(
      document.createTextNode(latest.name + " · released " + new Date(latest.published_at).toLocaleDateString(undefined, { dateStyle: "medium" }) + " · "),
      link(latest.html_url, "release notes"),
    );
    for (const row of document.querySelectorAll(".row[data-file]")) {
      const asset = assets.find((candidate) => candidate.name.endsWith(row.dataset.file));
      if (!asset) continue;
      row.href = asset.browser_download_url;
      row.querySelector(".name").textContent = asset.name;
      row.querySelector(".size").textContent = filesize(asset.size);
    }
  }

  if (handheld()) handheldCard();
  else if (key) show(key, assets);
}

start();
</script>
