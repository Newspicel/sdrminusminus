---
import { canonical, jsonLd, NAME, SHARE_IMAGE } from "../seo";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  summary: string;
  current?: "download" | "business";
  structured?: unknown;
}

const { title, description, summary, current, structured } = Astro.props;
const url = canonical(Astro.url.pathname);
const image = canonical(SHARE_IMAGE.path);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0f10" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(SHARE_IMAGE.width)} />
    <meta property="og:image:height" content={String(SHARE_IMAGE.height)} />
    <meta property="og:image:alt" content={`${NAME}: patch a radio together`} />
    <meta name="twitter:card" content="summary_large_image" />
    {structured !== undefined && <script type="application/ld+json" set:html={jsonLd(structured)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="bar">
      <div class="wrap">
        <a class="mark" href="/"><img src="/icon.svg" alt="" width="24" height="24" />SDR--</a>
        <nav>
          <a href="/introduction.html">Docs</a>
          <a class="hardware" href="/hardware.html">Hardware</a>
          <a class="business" href="/business.html" aria-current={current === "business" ? "page" : undefined}>Business</a>
          <a href="https://github.com/Newspicel/sdrminusminus">GitHub</a>
          <a class="discord" href="https://discord.gg/dYaRyGwBNw">Discord</a>
          <a class="get" href="/download.html" aria-current={current === "download" ? "page" : undefined}>Download</a>
        </nav>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <span>SDR-- · AGPL-3.0-or-later</span>
        <nav>
          <a href="/download.html">Download</a>
          <a href="/introduction.html">Docs</a>
          <a href="/hardware.html">Hardware</a>
          <a href="/troubleshooting.html">Troubleshooting</a>
          <a href="/development/building.html">Build from source</a>
          <a href="/business.html">Business</a>
          <a href="https://github.com/Newspicel/sdrminusminus">GitHub</a>
          <a href="https://discord.gg/dYaRyGwBNw">Discord</a>
          <a href="/imprint.html">Imprint</a>
          <a href="/privacy.html">Privacy</a>
        </nav>
      </div>
    </footer>

    <script>
      for (const shell of document.querySelectorAll<HTMLElement>(".shell")) {
        const code = shell.querySelector("pre");
        if (code === null) {
          continue;
        }
        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy";
        button.textContent = "Copy";
        button.addEventListener("click", async () => {
          const lines = [...code.childNodes]
            .filter((node) => !(node instanceof HTMLElement && node.classList.contains("p")))
            .map((node) => node.textContent ?? "")
            .join("");
          try {
            await navigator.clipboard.writeText(lines.replace(/\n{2,}/g, "\n").trim());
            button.textContent = "Copied";
          } catch {
            button.textContent = "Select and copy";
          }
          button.dataset.done = "";
          setTimeout(() => {
            button.textContent = "Copy";
            delete button.dataset.done;
          }, 1600);
        });
        shell.append(button);
      }
    </script>
  </body>
</html>
