---
const wires = [
  { id: "tune", port: "iq", d: "M150 172 H210" },
  { id: "listen", port: "audio", d: "M360 172 C392 172 388 62 420 62" },
  { id: "decode", port: "events", d: "M360 196 H420" },
  { id: "record", port: "iq", d: "M150 172 C204 172 176 302 236 302 H420" },
];

const nodes = [
  { x: 0, y: 150, w: 150, h: 78, title: "RTL-SDR", cat: "source" },
  { x: 210, y: 150, w: 150, h: 78, title: "BROADCAST FM", cat: "channel" },
  { x: 420, y: 40, w: 140, h: 70, title: "SPEAKER", cat: "output" },
  { x: 420, y: 174, w: 140, h: 78, title: "DECODER LOG", cat: "output" },
  { x: 420, y: 280, w: 140, h: 70, title: "RECORDER", cat: "output" },
];

const meter = [0.9, 0.7, 1, 0.8, 0.55, 0.85, 0.65, 0.95, 0.5, 0.75, 0.6, 0.9, 0.4, 0.7];
---

<svg
  class="patch"
  viewBox="-8 24 576 340"
  role="img"
  aria-label="A radio wired to a broadcast FM channel, which feeds a speaker and a decoder log. The radio also feeds a recorder."
>
  {
    wires.map((wire) => (
      <g class={`wire ${wire.port}`}>
        <path d={wire.d} />
        <circle r="3.5" style={`offset-path: path("${wire.d}")`} class={`pulse ${wire.id}`} />
      </g>
    ))
  }

  {
    nodes.map((node) => (
      <g class={`node ${node.cat}`} transform={`translate(${node.x} ${node.y})`}>
        <rect class="face" width={node.w} height={node.h} rx="3" />
        <rect class="head" width={node.w} height="20" rx="3" />
        <rect class="cat" width="3" height="20" />
        <text class="title" x="10" y="14">
          {node.title}
        </text>
      </g>
    ))
  }

  <g transform="translate(0 150)">
    <text class="freq" x="10" y="48">100.000<tspan class="unit" dx="4">MHz</tspan></text>
    <text class="dim" x="10" y="66">RATE 2.4 MS/s</text>
  </g>

  <g transform="translate(210 150)">
    <text class="freq" x="10" y="48">100.000<tspan class="unit" dx="4">MHz</tspan></text>
    <rect class="track" x="10" y="58" width="130" height="4" rx="2" />
    <rect class="level" x="10" y="58" width="92" height="4" rx="2" />
  </g>

  <g transform="translate(420 40)" class="meter">
    {meter.map((height, index) => <rect x={10 + index * 9} y={60 - height * 30} width="5" height={height * 30} rx="1" />)}
  </g>

  <g transform="translate(420 174)">
    <text class="dim" x="10" y="40">PS<tspan class="ink" dx="10">RADIO 1</tspan></text>
    <text class="dim" x="10" y="58">PTY<tspan class="ink" dx="4">Pop music</tspan></text>
  </g>

  <g transform="translate(420 280)">
    <circle class="rec" cx="16" cy="44" r="4" />
    <text class="ink" x="28" y="48">00:42</text>
    <text class="dim" x="84" y="48">SigMF</text>
  </g>

  <g class="ports">
    <circle class="iq" cx="150" cy="172" r="4" />
    <circle class="iq" cx="210" cy="172" r="4" />
    <circle class="audio" cx="360" cy="172" r="4" />
    <circle class="events" cx="360" cy="196" r="4" />
    <circle class="audio" cx="420" cy="62" r="4" />
    <circle class="events" cx="420" cy="196" r="4" />
    <circle class="iq" cx="420" cy="302" r="4" />
  </g>
</svg>

<style>
  .patch {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--mono);
  }

  .wire path {
    fill: none;
    stroke: var(--port);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.85;
  }
  .wire .pulse {
    fill: var(--port);
    offset-rotate: 0deg;
    opacity: 0;
  }
  .iq { --port: var(--iq); }
  .audio { --port: var(--audio); }
  .events { --port: var(--events); }

  .face { fill: var(--panel); stroke: var(--line-strong); stroke-width: 1; }
  .head { fill: var(--panel-2); }
  .cat { fill: var(--cat); }
  .source { --cat: var(--cat-source); }
  .channel { --cat: var(--cat-channel); }
  .output { --cat: var(--cat-output); }
  .title { fill: var(--ink-dim); font-size: 8.5px; letter-spacing: 0.06em; }

  .freq { fill: var(--ink); font-size: 19px; letter-spacing: 0.02em; }
  .unit { fill: var(--ink-faint); font-size: 8px; }
  .dim { fill: var(--ink-faint); font-size: 9px; letter-spacing: 0.04em; }
  .ink { fill: var(--ink); font-size: 11px; letter-spacing: 0.02em; }
  .track { fill: var(--panel-3); }
  .level { fill: var(--accent); }
  .meter rect { fill: var(--audio); opacity: 0.8; transform-box: fill-box; transform-origin: bottom; }
  .rec { fill: var(--danger); }

  .ports circle { fill: var(--port); stroke: var(--bg); stroke-width: 2; }

  @media (prefers-reduced-motion: no-preference) {
    .wire .pulse { animation: flow 2.6s linear infinite; }
    .pulse.listen, .pulse.decode { animation-delay: 1.1s; }
    .pulse.record { animation-duration: 3.4s; animation-delay: 0.4s; }
    .meter rect { animation: bounce 0.9s ease-in-out infinite alternate; }
    .meter rect:nth-child(3n) { animation-delay: -0.3s; }
    .meter rect:nth-child(3n + 1) { animation-delay: -0.6s; }
    .rec { animation: blink 1.6s steps(2, jump-none) infinite; }
  }

  @keyframes flow {
    0% { offset-distance: 0%; opacity: 0; }
    10%, 85% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }
  @keyframes bounce {
    to { transform: scaleY(0.45); }
  }
  @keyframes blink {
    50% { opacity: 0.25; }
  }
</style>
