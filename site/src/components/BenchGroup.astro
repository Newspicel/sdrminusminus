---
import { amount, type Group, ours, ranked, width } from "../bench";

interface Props {
  group: Group;
}

const { group } = Astro.props;
---

<figure>
  <figcaption>
    {group.title}
    <span title={group.better === "higher" ? "Higher is better" : "Lower is better"}>
      {group.unit} {group.better === "higher" ? "↑" : "↓"}
    </span>
  </figcaption>
  <ol>
    {
      ranked(group).map((entry) => (
        <li class:list={{ self: ours(entry) }}>
          <span class="tool" title={entry.version}>
            {entry.tool}
          </span>
          <span class="bar" style={`--w: ${width(entry, group)}`} />
          <span class="value">{amount(entry.value)}</span>
        </li>
      ))
    }
  </ol>
  {group.note && <p class="fine">{group.note}</p>}
</figure>

<style>
  figure {
    margin: 0;
    padding: 16px 18px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-face);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
    font-weight: 600;
  }
  figcaption span { font: 12px var(--mono); color: var(--ink-faint); white-space: nowrap; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  li {
    display: grid;
    grid-template-columns: 14ch 1fr 6ch;
    align-items: center;
    gap: 10px;
    font: 13px var(--mono);
    color: var(--ink-dim);
  }
  .tool { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bar {
    height: 10px;
    width: calc(var(--w) * 100%);
    min-width: 2px;
    background: var(--line-strong);
    border-radius: 2px;
  }
  .value { text-align: right; }
  .fine { margin: 12px 0 0; font-size: 13px; color: var(--ink-faint); }
  .self { color: var(--ink); }
  .self .bar { background: var(--accent); }
</style>
