    {
      "kind": "array",
      "name": "Array",
      "category": "tool",
      "summary": "Radio lanes as one antenna array",
      "ports": [
        {
          "name": "lane",
          "port_type": "iq",
          "direction": "in",
          "multi": false,
          "repeat": "per_lane",
          "note": "One radio lane per antenna, in antenna order"
        },
        {
          "name": "position",
          "port_type": "position",
          "direction": "in",
          "multi": false,
          "note": "Array place and heading"
        },
        {
          "name": "array",
          "port_type": "array",
          "direction": "out",
          "multi": true
        }
      ],
      "needs_channel_type": false,
      "default_body": {
        "kind": "array",
        "data": {
          "geometry": {
            "kind": "uca",
            "radius_m": 0.35,
            "first_deg": 0.0,
            "winding": "clockwise"
          },
          "orientation": {
            "kind": "fixed",
            "azimuth_deg": 0.0
          },
          "declared": "time_sync",
          "tuning": "together",
          "cal": {
            "source": {
              "kind": "noise"
            },
            "check_s": 60,
            "equaliser": false,
            "warm_start": true
          }
        }
      }
    },
    {
      "kind": "channel",
      "name": "Channel",
      "category": "channel",
      "summary": "Tunes and decodes one signal",
      "ports": [
        {
          "name": "iq",
          "port_type": "iq",
          "direction": "in",
          "multi": true,
          "note": "every radio that may carry this decoder; it runs on the one that hears it"
        },
        {
          "name": "control",
          "port_type": "control",
          "direction": "in",
          "multi": false,
          "note": "a scanner, signal hunt or satellite drives this decoder; its radio follows"
        },
        {
          "name": "position",
          "port_type": "position",
          "direction": "in",
          "multi": false,
          "condition": "channel_needs_position"
        },
        {
          "name": "baseband",
          "port_type": "baseband",
          "direction": "out",
          "multi": true
        },
        {
          "name": "audio",
          "port_type": "audio",
          "direction": "out",
          "multi": true,
          "condition": "channel_has_audio"
        },
        {
          "name": "events",
          "port_type": "events",
          "direction": "out",
          "multi": true,
          "condition": "channel_is_decoder"
        },
        {
          "name": "video",
          "port_type": "video",
          "direction": "out",
          "multi": true,
          "condition": "channel_has_video"
        }
      ],
      "needs_channel_type": true,
      "default_body": {
        "kind": "channel",
        "data": {
          "channel_type": "",
          "record_calls": false,
          "tuning_locked": false
        }
      }
    },
