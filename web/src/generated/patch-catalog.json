{
  "nodes": [
    {
      "kind": "device",
      "name": "Device",
      "category": "source",
      "summary": "A radio, where every patch starts",
      "ports": [
        {
          "name": "tx",
          "port_type": "tx",
          "direction": "in",
          "multi": false,
          "condition": "device_is_tx_capable",
          "repeat": "per_tx_stream",
          "note": "reserved: transmit is not built (), so nothing in this build emits a signal to key a radio with"
        },
        {
          "name": "iq",
          "port_type": "iq",
          "direction": "out",
          "multi": true,
          "repeat": "per_rx_stream"
        }
      ],
      "needs_channel_type": false,
      "default_body": {
        "kind": "device",
        "data": {}
      }
    },
    {
      "kind": "recording",
      "name": "Recording",
      "category": "source",
      "summary": "Plays back a recorded IQ file",
      "ports": [
        {
          "name": "iq",
          "port_type": "iq",
          "direction": "out",
          "multi": true,
          "repeat": "per_rx_stream"
        }
      ],
      "needs_channel_type": false,
      "default_body": {
        "kind": "recording",
        "data": {}
      }
    },
