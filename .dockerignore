# Build context for the Dockerfile. Everything the image needs is copied explicitly there:
# Cargo.toml, Cargo.lock, rust-toolchain.toml, .cargo/, crates/, apps/, xtask/, web/, and the
# pinned packaging environment: none of which may be excluded here.

.git
.github
.claude

# Rebuilt inside the image. web/node_modules and web/dist are load-bearing exclusions: the web
# stage installs before it copies sources, and these would clobber that install.
target
**/target
web/node_modules
web/dist
apps/desktop/gen

# Recorded IQ test fixtures, megabytes of them. Only broadcast_audio is kept: the signal
# generator compiles those few encoded media files into the binary.
fixtures/*
!fixtures/broadcast_audio

# The media stage builds FFmpeg itself; a developer's local build tree and prefix are megabytes
# of context no stage reads.
.media
.media-build

# Plans, docs and generated specs: no stage reads them, apart from the notices the runtime
# ships (the TS client is checked in under web/src/generated, so the image never needs
# openapi.json).
*.md
!THIRD_PARTY_NOTICES.md
openapi.json

Dockerfile
.dockerignore
docker-compose.yml
