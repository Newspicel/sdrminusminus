<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime otherwise refuses to load any library not signed by this team, and
	     the SDRplay API is signed by SDRplay: without this the staged SoapySDRPlay3 module can
	     never reach the vendor library, no matter how the user installs it. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
